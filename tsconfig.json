{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@cbt-journal/di": ["./packages/di/src/index.ts"]
    }
  },
  "include": [
    "src",
    "test",
    "packages/*/src",
    "packages/*/test",
    "vitest.config.ts",
    "vitest.nodb.config.ts",
    "packages/*/vitest.config.ts"
  ]
}
