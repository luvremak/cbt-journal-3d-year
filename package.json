{
  "name": "cbt-journal",
  "version": "0.1.0",
  "private": true,
  "description": "Спрощений CBT-журнал: REST API для клієнтів і терапевтів",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @cbt-journal/di && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "prepare": "simple-git-hooks || echo git hooks skipped",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run -c vitest.nodb.config.ts test/unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "test:nodb": "vitest run -c vitest.nodb.config.ts",
    "mutation:sql": "bash scripts/sql-mutation.sh",
    "test:report": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=reports/tests.json",
    "report": "node scripts/quality-report.mjs",
    "start:prod": "node dist/db/migrate.js && node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "start:staging": "node dist/db/migrate.js && node dist/db/seed.js && node dist/index.js",
    "test:di": "npm test -w @cbt-journal/di",
    "mutation:di": "npm run mutation -w @cbt-journal/di",
    "perf:prepare": "tsx perf/prepare.ts",
    "perf": "tsx perf/load.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && npm run typecheck && npm run test:unit",
    "commit-msg": "npx --no -- commitlint --edit \"$1\""
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/autocannon": "^7.12.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "autocannon": "^9.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@cbt-journal/di": "1.0.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "workspaces": [
    "packages/*"
  ]
}
